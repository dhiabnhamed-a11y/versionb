model Project {
  id          String     @id @default(cuid())
  title       String
  description String?
  companyId   String
  roomId      String?
  categoryId  String?
  clientId    String?
  clientName  String?
  managerId   String?
  hasCamera   Boolean    @default(false)
  cameraType  CameraType @default(device)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id])
  room                   Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category               ProjectCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager                User?                   @relation("ProjectManager", fields: [managerId], references: [id])
  tasks                  Task[]
  invoices               Invoice[]               @relation("InvoiceCampaign")
  contracts              Contract[]
  briefs                 Brief[]
  deliverables           Deliverable[]
  cameraMedia            ProjectCameraMedia[]
  projectMedia           ProjectMedia[]
  cameras                ProjectCamera[]
  calendarEvents         CalendarEvent[]
  clientPortalComments   ClientPortalComment[]
  journalLines           JournalLine[]
  expenses               Expense[]
  payrollItems           PayrollItem[]
  timeEntries            TimeEntry[]
  budgets                Budget[]
  budgetLines            BudgetLine[]
  financialMetrics       FinancialMetric[]
  profitabilitySnapshots ProfitabilitySnapshot[]

  @@index([companyId, roomId])
  @@index([companyId, categoryId])
  @@index([companyId, clientId])
  @@index([companyId, updatedAt])
}

model ChartOfAccount {
