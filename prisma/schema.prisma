  @@unique([companyId, code])
  @@index([companyId, status, code])
  @@index([companyId, parentCostCenterId])
}

model Account {
  id              String                 @id @default(cuid())
  companyId       String
  chartId         String?
  categoryId      String?
  parentAccountId String?
  code            String
  name            String
  description     String?
  type            FinancialAccountType
  normalBalance   FinancialNormalBalance
  currency        String                 @default("USD")
  status          FinancialRecordStatus  @default(ACTIVE)
  isSystem        Boolean                @default(false)
  metadata        Json?
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chart            ChartOfAccount?   @relation(fields: [chartId], references: [id], onDelete: SetNull)
  category         AccountCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent           Account?          @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  children         Account[]         @relation("AccountHierarchy")
  journalLines     JournalLine[]
  ledgers          Ledger[]
  reconciliations  Reconciliation[]
  treasuryAccounts TreasuryAccount[]
  budgetLines      BudgetLine[]
  financialMetrics FinancialMetric[]

  @@unique([companyId, code])
  @@index([companyId, type, status])
  @@index([companyId, categoryId])
  @@index([companyId, parentAccountId])
  @@index([chartId])
}

model FinancialPeriod {
