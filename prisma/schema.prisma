enum ERPFiscalYearStatus {
  OPEN
  CLOSED
  LOCKED
}

model ERPFiscalYear {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  startDate   DateTime
  endDate     DateTime
  isLocked    Boolean            @default(false)
  status      ERPFiscalYearStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  isDeleted   Boolean            @default(false)
  accounts    ERPAccount[]
  periods     ERPPeriod[]
}

model ERPPeriod {
  id           String       @id @default(cuid())
  workspaceId  String
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  isLocked     Boolean      @default(false)
  fiscalYear   ERPFiscalYear @relation(fields: [fiscalYearId], references: [id])
  journalEntries ERPJournalEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  isDeleted    Boolean      @default(false)
}

enum ERPAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ERPAccount {
  id           String        @id @default(cuid())
  workspaceId  String
  fiscalYearId String
  code         String
  name         String
  type         ERPAccountType
  subtype      String?
  parentId     String?
  parent       ERPAccount?   @relation("ERPAccountTree", fields: [parentId], references: [id])
  children     ERPAccount[]  @relation("ERPAccountTree")
  isActive     Boolean       @default(true)
  currency     String        @default("USD")
  description  String?
  fiscalYear   ERPFiscalYear @relation(fields: [fiscalYearId], references: [id])
  journalLines   ERPJournalLine[]
  accountBalances ERPAccountBalance[]
  createdAt      DateTime          @default(now())
  updatedAt    DateTime      @updatedAt
  isDeleted    Boolean       @default(false)
  @@unique([workspaceId, code])
}

enum ERPJournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model ERPJournalEntry {
  id           String          @id @default(cuid())
  workspaceId  String
  periodId     String
  entryNumber  String
  date         DateTime
  description  String
  reference    String?
  status       ERPJournalStatus @default(DRAFT)
  sourceType   String?
  sourceId     String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  period       ERPPeriod       @relation(fields: [periodId], references: [id])
  lines        ERPJournalLine[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isDeleted    Boolean         @default(false)
}

model ERPJournalLine {
  id             String          @id @default(cuid())
  workspaceId    String
  journalEntryId String
  accountId      String
  description    String?
  debit          Int             @default(0)
  credit         Int             @default(0)
  currency       String          @default("USD")
  exchangeRate   Float           @default(1.0)
  departmentId   String?
  projectId      String?
  costCenterId   String?
  isReconciled   Boolean         @default(false)
  journalEntry   ERPJournalEntry @relation(fields: [journalEntryId], references: [id])
  account        ERPAccount      @relation(fields: [accountId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isDeleted      Boolean         @default(false)
}

