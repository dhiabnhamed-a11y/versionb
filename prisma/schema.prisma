generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            String   @default("EMPLOYEE") // SUPER_ADMIN, OWNER, MANAGER, EMPLOYEE
  accountStatus   String   @default("ACTIVE") // PENDING, ACTIVE, REJECTED, DISABLED
  avatar          String?
  authUserId      String?  @unique @db.Uuid
  companyId       String?
  preferredLocale String   @default("en") // en, fr, ar
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company                      Company?                         @relation("CompanyMembers", fields: [companyId], references: [id])
  ownedCompany                 Company?                         @relation("CompanyOwner")
  managedProjects              Project[]                        @relation("ProjectManager")
  assignedTasks                Task[]                           @relation("TaskAssignee")
  activities                   Activity[]
  sentAlerts                   Alert[]                          @relation("AlertSender")
  receivedAlerts               Alert[]                          @relation("AlertRecipient")
  pushTokens                   PushToken[]
  createdInvites               Invite[]                         @relation("InviteCreatedBy")
  redeemedInvites              Invite[]                         @relation("InviteUsedBy")
  reviewedAccessRequests       AccessRequest[]                  @relation("AccessRequestReviewedBy")
  reviewedCompanies            Company[]                        @relation("CompanyReviewedBy")
  taskSubmissions              TaskSubmission[]
  projectMediaUploads          ProjectMedia[]                   @relation("ProjectMediaUploadedBy")
  comments                     Comment[]
  calendarEvents               CalendarEvent[]                  @relation("CalendarEventCreatedBy")
  adminActions                 AdminActionLog[]                 @relation("AdminActionActor")
  targetedAdminActions         AdminActionLog[]                 @relation("AdminActionTarget")
  createdInvoices              Invoice[]                        @relation("InvoiceCreatedBy")
  clientActivities             ClientActivity[]                 @relation("ClientActivityActor")
  createdBriefs                Brief[]                          @relation("BriefCreatedBy")
  uploadedDeliverableFiles     DeliverableFile[]                @relation("DeliverableFileUploadedBy")
  approvalDecisions            ApprovalDecision[]               @relation("ApprovalDecisionDecidedBy")
  deliverableActivities        DeliverableActivity[]            @relation("DeliverableActivityActor")
  assignedSubtasks             Subtask[]                        @relation("SubtaskAssignee")
  aiConversations              AiConversation[]
  aiMemories                   AiMemory[]
  aiRuns                       AiRun[]                          @relation("AiRunActor")
  aiActionRuns                 AiActionRun[]                    @relation("AiActionRunActor")
  aiToolExecutions             AiToolExecution[]                @relation("AiToolExecutionActor")
  aiConversationStates         AiConversationState[]            @relation("AiConversationStateActor")
  aiPendingActions             AiPendingAction[]                @relation("AiPendingActionActor")
  aiWorkflowSteps              AiWorkflowStep[]                 @relation("AiWorkflowStepActor")
  aiActionContexts             AiActionContext[]                @relation("AiActionContextActor")
  requestedAiApprovals         AiApproval[]                     @relation("AiApprovalRequester")
  assignedAiApprovals          AiApproval[]                     @relation("AiApprovalApprover")
  decidedAiApprovals           AiApproval[]                     @relation("AiApprovalDecider")
  aiObservations               AiObservation[]                  @relation("AiObservationActor")
  aiDecisions                  AiDecision[]                     @relation("AiDecisionActor")
  createdContracts             Contract[]                       @relation("ContractCreatedBy")
  approvedContracts            Contract[]                       @relation("ContractApprovedBy")
  createdContractVersions      ContractVersion[]                @relation("ContractVersionCreatedBy")
  createdContractTemplates     ContractTemplate[]               @relation("ContractTemplateCreatedBy")
  contractSignatures           ContractSignature[]              @relation("ContractSignatureSigner")
  contractAuditLogs            ContractAuditLog[]               @relation("ContractAuditActor")
  contractGenerationJobs       ContractGenerationJob[]          @relation("ContractGenerationActor")
  financialPeriodsClosed       FinancialPeriod[]                @relation("FinancialPeriodClosedBy")
  journalEntriesCreated        JournalEntry[]                   @relation("JournalEntryCreatedBy")
  journalEntriesApproved       JournalEntry[]                   @relation("JournalEntryApprovedBy")
  journalEntriesPosted         JournalEntry[]                   @relation("JournalEntryPostedBy")
  financialAuditLogs           FinancialAuditLog[]              @relation("FinancialAuditActor")
  compensationProfile          EmployeeCompensationProfile?
  payrollRunsProcessed         Payroll[]                        @relation("PayrollProcessedBy")
  payrollRunsApproved          Payroll[]                        @relation("PayrollApprovedBy")
  payrollItems                 PayrollItem[]                    @relation("PayrollItemEmployee")
  expensesSubmitted            Expense[]                        @relation("ExpenseSubmittedBy")
  expensesApproved             Expense[]                        @relation("ExpenseApprovedBy")
  treasuryTransactionsCreated  TreasuryTransaction[]            @relation("TreasuryTransactionCreatedBy")
  treasuryTransactionsApproved TreasuryTransaction[]            @relation("TreasuryTransactionApprovedBy")
  approvalFlowsCreated         ApprovalFlow[]                   @relation("ApprovalFlowCreatedBy")
  approvalStepsAssigned        ApprovalStep[]                   @relation("ApprovalStepAssignedTo")
  approvalStepsDecided         ApprovalStep[]                   @relation("ApprovalStepDecidedBy")
  timeEntries                  TimeEntry[]                      @relation("TimeEntryEmployee")
  dashboardDesign              UserDashboardDesign?
  auditLogs                    AuditLog[]                       @relation("AuditLogActor")
  notificationPreferences      NotificationPreference?
  connectedSocialAccounts      ConnectedAccount[]               @relation("ConnectedAccountConnectedBy")
  ownedCreatorProfiles         CreatorProfile[]                 @relation("CreatorProfileOwner")
  integrationActivityLogs      IntegrationActivityLog[]         @relation("IntegrationActivityActor")
  authSessions                 AuthSession[]                    @relation("UserAuthSessions")
  revokedTokens                RevokedToken[]                   @relation("UserRevokedTokens")
  mfaFactors                   MfaFactor[]                      @relation("UserMfaFactors")
  mfaRecoveryCodes             MfaRecoveryCode[]                @relation("UserMfaRecoveryCodes")
  legalConsents                LegalConsent[]                   @relation("UserLegalConsents")
  publishedLegalVersions       LegalDocumentVersion[]           @relation("LegalDocumentVersionPublisher")
  managedEnterpriseDepartments EnterpriseDepartment[]           @relation("EnterpriseDepartmentManager")
  ledEnterpriseTeams           EnterpriseTeam[]                 @relation("EnterpriseTeamLeader")
  enterpriseTeamMemberships    EnterpriseTeamMember[]           @relation("EnterpriseTeamMemberUser")
  enterpriseTaskAssignments    EnterpriseTaskAssignment[]       @relation("EnterpriseTaskAssignmentMember")
  assignedEnterpriseAssets     EnterpriseAsset[]                @relation("EnterpriseAssetAssignedUser")
  reportedEnterpriseIncidents  EnterpriseIncident[]             @relation("EnterpriseIncidentReporter")
  assignedEnterpriseIncidents  EnterpriseIncident[]             @relation("EnterpriseIncidentAssignee")
  maintenanceAssignments       EnterpriseMaintenanceWorkOrder[] @relation("EnterpriseMaintenanceTechnician")
  enterpriseRoleAssignments    EnterpriseRoleAssignment[]       @relation("EnterpriseRoleAssignmentUser")
  enterpriseApprovalWorkflows  EnterpriseApprovalWorkflow[]     @relation("EnterpriseApprovalWorkflowCreatedBy")
  enterpriseAuditEvents        EnterpriseAuditEvent[]           @relation("EnterpriseAuditActor")
}

model Company {
  id                 String    @id @default(cuid())
  name               String
  emailDomain        String?   @unique
  companyType        String    @default("OTHER")
  country            String?
  industry           String?
  registrationNumber String?   @unique
  status             String    @default("PENDING") // PENDING, ACTIVE, REJECTED, DISABLED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  ownerId            String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  trialEndsAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  planType             PlanType           @default(FREE_TRIAL)
  seatCount            Int                @default(1)
  billingInterval      BillingInterval?
  selfServeSignup      Boolean            @default(false)

  owner                        User                             @relation("CompanyOwner", fields: [ownerId], references: [id])
  reviewedBy                   User?                            @relation("CompanyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  members                      User[]                           @relation("CompanyMembers")
  rooms                        Room[]
  projectCategories            ProjectCategory[]
  projects                     Project[]
  invites                      Invite[]
  accessRequests               AccessRequest[]
  calendarEvents               CalendarEvent[]
  settings                     CompanySettings?
  adminActionLogs              AdminActionLog[]
  clients                      Client[]
  clientActivities             ClientActivity[]
  clientPortalComments         ClientPortalComment[]
  invoices                     Invoice[]
  contracts                    Contract[]
  contractVersions             ContractVersion[]
  contractTemplates            ContractTemplate[]
  contractClauses              ContractClause[]
  contractSignatures           ContractSignature[]
  contractAuditLogs            ContractAuditLog[]
  contractGenerationJobs       ContractGenerationJob[]
  chartOfAccounts              ChartOfAccount[]
  accounts                     Account[]
  financialPeriods             FinancialPeriod[]
  journalEntries               JournalEntry[]
  journalLines                 JournalLine[]
  ledgers                      Ledger[]
  reconciliations              Reconciliation[]
  transactionReferences        TransactionReference[]
  erpSettings                  ErpWorkspaceSettings?
  accountCategories            AccountCategory[]
  costCenters                  CostCenter[]
  exchangeRates                ExchangeRate[]
  financialAuditLogs           FinancialAuditLog[]
  vendors                      Vendor[]
  expenseCategories            ExpenseCategory[]
  expenses                     Expense[]
  employeeCompensationProfiles EmployeeCompensationProfile[]
  payrollRuns                  Payroll[]
  payrollItems                 PayrollItem[]
  treasuryAccounts             TreasuryAccount[]
  treasuryTransactions         TreasuryTransaction[]
  budgets                      Budget[]
  budgetLines                  BudgetLine[]
  forecasts                    Forecast[]
  financialMetrics             FinancialMetric[]
  profitabilitySnapshots       ProfitabilitySnapshot[]
  approvalFlows                ApprovalFlow[]
  approvalSteps                ApprovalStep[]
  timeEntries                  TimeEntry[]
  briefs                       Brief[]
  deliverables                 Deliverable[]
  workflowTemplates            WorkflowTemplate[]
  ApprovalDecision             ApprovalDecision[]
  DeliverableActivity          DeliverableActivity[]
  aiConversations              AiConversation[]
  aiMemories                   AiMemory[]
  aiRuns                       AiRun[]
  aiActionRuns                 AiActionRun[]
  aiSteps                      AiStep[]
  aiToolExecutions             AiToolExecution[]
  aiConversationStates         AiConversationState[]
  aiPendingActions             AiPendingAction[]
  aiWorkflowSteps              AiWorkflowStep[]
  aiActionContexts             AiActionContext[]
  aiApprovals                  AiApproval[]
  aiObservations               AiObservation[]
  aiDecisions                  AiDecision[]
  activities                   Activity[]
  auditLogs                    AuditLog[]
  alerts                       Alert[]
  jobRuns                      JobRun[]
  searchIndexes                SearchIndex[]
  analyticsMetrics             AnalyticsMetric[]
  creatorProfiles              CreatorProfile[]
  connectedSocialAccounts      ConnectedAccount[]
  analyticsSnapshots           AnalyticsSnapshot[]
  realtimeMetrics              RealtimeMetric[]
  audienceDemographics         AudienceDemographic[]
  engagementMetrics            EngagementMetric[]
  revenueMetrics               RevenueMetric[]
  contentPerformance           ContentPerformance[]
  socialAiInsights             SocialAiInsight[]
  socialSyncJobs               SocialSyncJob[]
  socialWebhookEvents          SocialWebhookEvent[]
  integrationActivityLogs      IntegrationActivityLog[]
  idempotencyKeys              IdempotencyKey[]
  authSessions                 AuthSession[]                    @relation("CompanyAuthSessions")
  revokedTokens                RevokedToken[]                   @relation("CompanyRevokedTokens")
  securityNonces               SecurityNonce[]                  @relation("CompanySecurityNonces")
  legalConsents                LegalConsent[]                   @relation("CompanyLegalConsents")
  enterpriseDepartments        EnterpriseDepartment[]
  enterpriseTeams              EnterpriseTeam[]
  enterpriseTeamMembers        EnterpriseTeamMember[]
  enterpriseTaskAssignments    EnterpriseTaskAssignment[]
  enterpriseSlaPolicies        EnterpriseSlaPolicy[]
  enterpriseAssetCategories    EnterpriseAssetCategory[]
  enterpriseAssets             EnterpriseAsset[]
  enterpriseIncidents          EnterpriseIncident[]
  enterpriseMaintenancePlans   EnterpriseMaintenancePlan[]
  enterpriseMaintenanceOrders  EnterpriseMaintenanceWorkOrder[]
  enterpriseComplianceControls EnterpriseComplianceControl[]
  enterpriseApprovalWorkflows  EnterpriseApprovalWorkflow[]
  enterpriseRoleAssignments    EnterpriseRoleAssignment[]
  enterpriseAuditEvents        EnterpriseAuditEvent[]
  enterpriseShifts             EnterpriseShift[]
  subscriptionEvents           SubscriptionEvent[]
  emsCompany                   EmsCompany?

  @@index([status, createdAt])
  @@index([name, registrationNumber, status])
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  country       String?
  address       String?
  notes         String?
  avatarUrl     String?
  status        String   @default("active") // active, inactive
  portalToken   String?  @unique
  portalEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects               Project[]
  invoices               Invoice[]
  contracts              Contract[]
  contractSignatures     ContractSignature[]
  contractGenerationJobs ContractGenerationJob[]
  activities             ClientActivity[]
  portalComments         ClientPortalComment[]
  briefs                 Brief[]
  approvals              ApprovalDecision[]
  journalLines           JournalLine[]
  expenses               Expense[]
  timeEntries            TimeEntry[]
  profitabilitySnapshots ProfitabilitySnapshot[]

  @@index([companyId, status, createdAt])
  @@index([companyId, companyName])
  @@index([companyId, email])
}

model ClientPortalComment {
  id            String   @id @default(cuid())
  companyId     String
  clientId      String
  campaignId    String?
  deliverableId String?
  authorName    String
  authorEmail   String?
  content       String
  createdAt     DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign    Project?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([campaignId, createdAt])
  @@index([deliverableId, createdAt])
}

model ClientActivity {
  id        String   @id @default(cuid())
  companyId String
  clientId  String
  actorId   String?
  type      String
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ClientActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model Invoice {
  id            String    @id @default(cuid())
  companyId     String
  createdById   String
  clientId      String?
  campaignId    String?
  briefId       String?
  invoiceNumber String
  clientName    String
  clientEmail   String?
  clientAddress String?
  status        String    @default("draft") // draft, sent, paid, overdue
  currency      String    @default("USD")
  locale        String    @default("en") // en, ar
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  notes         String?
  taxRate       Decimal   @default(0) @db.Decimal(5, 2)
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  client                Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign              Project?               @relation("InvoiceCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  brief                 Task?                  @relation("InvoiceBrief", fields: [briefId], references: [id], onDelete: SetNull)
  items                 InvoiceItem[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]
  treasuryTransactions  TreasuryTransaction[]
  transactionReferences TransactionReference[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status, dueDate])
  @@index([companyId, clientId, createdAt])
  @@index([companyId, campaignId, createdAt])
  @@index([companyId, briefId, createdAt])
  @@index([companyId, createdAt])
  @@index([createdById, createdAt])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  deliverableId String?
  description   String
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([deliverableId])
}

model Contract {
  id                   String    @id @default(cuid())
  companyId            String
  clientId             String?
  projectId            String?
  createdById          String
  approvedById         String?
  contractNumber       String
  title                String
  type                 String    @default("SERVICE_AGREEMENT")
  status               String    @default("draft") // draft, in_review, approved, sent, viewed, signed, expired, terminated, archived
  language             String    @default("en") // en, fr, ar, bilingual_en_fr, bilingual_en_ar
  currency             String    @default("USD")
  jurisdiction         String?
  governingLaw         String?
  confidentialityLevel String    @default("standard")
  riskProfile          String    @default("standard")
  currentVersionNumber Int       @default(1)
  effectiveDate        DateTime?
  expiryDate           DateTime?
  renewalDate          DateTime?
  sentAt               DateTime?
  viewedAt             DateTime?
  approvedAt           DateTime?
  signedAt             DateTime?
  terminatedAt         DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy     User?                   @relation("ContractApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  versions       ContractVersion[]
  signatures     ContractSignature[]
  auditLogs      ContractAuditLog[]
  generationJobs ContractGenerationJob[]

  @@unique([companyId, contractNumber])
  @@index([companyId, clientId, status, createdAt])
  @@index([companyId, projectId, createdAt])
  @@index([companyId, status, expiryDate])
  @@index([createdById, createdAt])
}

model ContractVersion {
  id               String   @id @default(cuid())
  companyId        String
  contractId       String
  createdById      String?
  versionNumber    Int
  status           String   @default("draft") // draft, generated, approved, sent, signed, superseded, archived
  locale           String   @default("en")
  title            String
  content          Json
  renderedSnapshot Json?
  dataSnapshot     Json?
  clauseSnapshot   Json?
  pdfStorageKey    String?
  pdfChecksum      String?
  pdfByteLength    Int?
  model            String   @default("taskit-contract-intelligence")
  promptVersion    String   @default("contract-v1")
  legalDisclaimer  String?
  watermark        String?
  immutable        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract   Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("ContractVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  signatures ContractSignature[]
  auditLogs  ContractAuditLog[]

  @@unique([contractId, versionNumber])
  @@index([companyId, status, createdAt])
  @@index([companyId, contractId, versionNumber])
}

model ContractTemplate {
  id            String   @id @default(cuid())
  companyId     String
  createdById   String?
  name          String
  type          String   @default("SERVICE_AGREEMENT")
  locale        String   @default("en")
  jurisdiction  String?
  status        String   @default("active") // active, draft, archived
  version       Int      @default(1)
  description   String?
  variables     Json?
  clauseSet     Json?
  branding      Json?
  approvalRules Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ContractTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  clauses   ContractClause[]

  @@index([companyId, status, type, locale])
  @@index([companyId, name])
}

model ContractClause {
  id           String   @id @default(cuid())
  companyId    String
  templateId   String?
  key          String
  title        String
  body         String
  locale       String   @default("en")
  category     String
  riskLevel    String   @default("standard")
  jurisdiction String?
  serviceType  String?
  sortOrder    Int      @default(0)
  required     Boolean  @default(true)
  conditions   Json?
  variables    Json?
  status       String   @default("active")
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, locale, version])
  @@index([companyId, category, locale, status])
  @@index([templateId, sortOrder])
}

model ContractSignature {
  id                 String    @id @default(cuid())
  companyId          String
  contractId         String
  versionId          String?
  clientId           String?
  signerUserId       String?
  signerType         String    @default("client") // company, client, witness, legal
  signerName         String
  signerEmail        String?
  status             String    @default("pending") // pending, requested, viewed, signed, declined, expired, voided
  method             String    @default("prepared") // prepared, electronic, manual, provider
  signingOrder       Int       @default(1)
  signingUrlHash     String?
  provider           String?
  providerEnvelopeId String?
  signatureData      Json?
  ipAddress          String?
  userAgent          String?
  requestedAt        DateTime?
  viewedAt           DateTime?
  signedAt           DateTime?
  declinedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version    ContractVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  signerUser User?            @relation("ContractSignatureSigner", fields: [signerUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([contractId, signingOrder])
  @@index([versionId, status])
  @@index([clientId, status, createdAt])
  @@index([signingUrlHash])
}

model ContractAuditLog {
  id         String   @id @default(cuid())
  companyId  String
  contractId String
  versionId  String?
  actorId    String?
  action     String
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version  ContractVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  actor    User?            @relation("ContractAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, contractId, createdAt])
  @@index([versionId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model ContractGenerationJob {
  id            String    @id @default(cuid())
  companyId     String
  contractId    String?
  clientId      String?
  actorId       String?
  jobRunId      String?
  status        String    @default("queued") // queued, collecting_data, generating, rendering_pdf, completed, failed, cancelled
  contractType  String    @default("SERVICE_AGREEMENT")
  language      String    @default("en")
  riskProfile   String    @default("standard")
  input         Json?
  missingFields Json?
  result        Json?
  error         String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actor    User?     @relation("ContractGenerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, clientId, createdAt])
  @@index([contractId, createdAt])
  @@index([jobRunId])
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique
  primaryColor    String   @default("#0369a1")
  backgroundColor String   @default("#f7f8fa")
  sidebarColor    String   @default("#ffffff")
  themeMode       String   @default("light") // light, dark
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ErpWorkspaceSettings {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  baseCurrency               String   @default("USD")
