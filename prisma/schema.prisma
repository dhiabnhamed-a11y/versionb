  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  ledger         Ledger?

  @@unique([journalEntryId, lineNumber])
  @@index([companyId, accountId, createdAt])
  @@index([companyId, departmentId, createdAt])
  @@index([companyId, costCenterId, createdAt])
  @@index([companyId, projectId, createdAt])
  @@index([companyId, clientId, createdAt])
  @@index([companyId, invoiceId, createdAt])
  @@index([companyId, taskId, createdAt])
  @@index([companyId, reconciliationId])
}

model Ledger {
