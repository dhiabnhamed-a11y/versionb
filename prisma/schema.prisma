  children AccountCategory[] @relation("AccountCategoryTree")
  accounts Account[]

  @@unique([companyId, code])
  @@index([companyId, rootType, sortOrder])
  @@index([companyId, parentCategoryId])
}

model CostCenter {
  id                 String                @id @default(cuid())
  companyId          String
  parentCostCenterId String?
