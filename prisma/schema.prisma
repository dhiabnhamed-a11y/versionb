generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            String   @default("EMPLOYEE") // SUPER_ADMIN, OWNER, MANAGER, EMPLOYEE
  accountStatus   String   @default("ACTIVE") // PENDING, ACTIVE, REJECTED, DISABLED
  avatar          String?
  authUserId      String?  @unique @db.Uuid
  companyId       String?
  preferredLocale String   @default("en") // en, fr, ar
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company                  Company?                @relation("CompanyMembers", fields: [companyId], references: [id])
  ownedCompany             Company?                @relation("CompanyOwner")
  managedProjects          Project[]               @relation("ProjectManager")
  assignedTasks            Task[]                  @relation("TaskAssignee")
  activities               Activity[]
  sentAlerts               Alert[]                 @relation("AlertSender")
  receivedAlerts           Alert[]                 @relation("AlertRecipient")
  pushTokens               PushToken[]
  createdInvites           Invite[]                @relation("InviteCreatedBy")
  redeemedInvites          Invite[]                @relation("InviteUsedBy")
  reviewedAccessRequests   AccessRequest[]         @relation("AccessRequestReviewedBy")
  reviewedCompanies        Company[]               @relation("CompanyReviewedBy")
  taskSubmissions          TaskSubmission[]
  projectMediaUploads      ProjectMedia[]          @relation("ProjectMediaUploadedBy")
  comments                 Comment[]
  calendarEvents           CalendarEvent[]         @relation("CalendarEventCreatedBy")
  adminActions             AdminActionLog[]        @relation("AdminActionActor")
  targetedAdminActions     AdminActionLog[]        @relation("AdminActionTarget")
  createdInvoices          Invoice[]               @relation("InvoiceCreatedBy")
  clientActivities         ClientActivity[]        @relation("ClientActivityActor")
  createdBriefs            Brief[]                 @relation("BriefCreatedBy")
  uploadedDeliverableFiles DeliverableFile[]       @relation("DeliverableFileUploadedBy")
  approvalDecisions        ApprovalDecision[]      @relation("ApprovalDecisionDecidedBy")
  deliverableActivities    DeliverableActivity[]   @relation("DeliverableActivityActor")
  assignedSubtasks         Subtask[]               @relation("SubtaskAssignee")
  aiConversations          AiConversation[]
  aiMemories               AiMemory[]
  dashboardDesign          UserDashboardDesign?
  auditLogs                AuditLog[]              @relation("AuditLogActor")
  notificationPreferences  NotificationPreference?
  connectedSocialAccounts  ConnectedAccount[]      @relation("ConnectedAccountConnectedBy")
  ownedCreatorProfiles     CreatorProfile[]        @relation("CreatorProfileOwner")
  integrationActivityLogs  IntegrationActivityLog[] @relation("IntegrationActivityActor")
}

model Company {
  id                 String    @id @default(cuid())
  name               String
  emailDomain        String?   @unique
  companyType        String    @default("OTHER")
  country            String?
  industry           String?
  registrationNumber String?   @unique
  status             String    @default("PENDING") // PENDING, ACTIVE, REJECTED, DISABLED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  ownerId            String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner                User                  @relation("CompanyOwner", fields: [ownerId], references: [id])
  reviewedBy           User?                 @relation("CompanyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  members              User[]                @relation("CompanyMembers")
  rooms                Room[]
  projectCategories    ProjectCategory[]
  projects             Project[]
  invites              Invite[]
  accessRequests       AccessRequest[]
  calendarEvents       CalendarEvent[]
  settings             CompanySettings?
  adminActionLogs      AdminActionLog[]
  clients              Client[]
  clientActivities     ClientActivity[]
  clientPortalComments ClientPortalComment[]
  invoices             Invoice[]
  briefs               Brief[]
  deliverables         Deliverable[]
  workflowTemplates    WorkflowTemplate[]
  ApprovalDecision     ApprovalDecision[]
  DeliverableActivity  DeliverableActivity[]
  aiConversations      AiConversation[]
  aiMemories           AiMemory[]
  activities           Activity[]
  auditLogs            AuditLog[]
  alerts               Alert[]
  jobRuns              JobRun[]
  searchIndexes        SearchIndex[]
  analyticsMetrics     AnalyticsMetric[]
  creatorProfiles      CreatorProfile[]
  connectedSocialAccounts ConnectedAccount[]
  analyticsSnapshots   AnalyticsSnapshot[]
  realtimeMetrics      RealtimeMetric[]
  audienceDemographics AudienceDemographic[]
  engagementMetrics    EngagementMetric[]
  revenueMetrics       RevenueMetric[]
  contentPerformance   ContentPerformance[]
  socialAiInsights     SocialAiInsight[]
  socialSyncJobs       SocialSyncJob[]
  socialWebhookEvents  SocialWebhookEvent[]
  integrationActivityLogs IntegrationActivityLog[]

  @@index([status, createdAt])
  @@index([name, registrationNumber, status])
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  country       String?
  address       String?
  notes         String?
  avatarUrl     String?
  status        String   @default("active") // active, inactive
  portalToken   String?  @unique
  portalEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects       Project[]
  invoices       Invoice[]
  activities     ClientActivity[]
  portalComments ClientPortalComment[]
  briefs         Brief[]
  approvals      ApprovalDecision[]

  @@index([companyId, status, createdAt])
  @@index([companyId, companyName])
  @@index([companyId, email])
}

model ClientPortalComment {
  id            String   @id @default(cuid())
  companyId     String
  clientId      String
  campaignId    String?
  deliverableId String?
  authorName    String
  authorEmail   String?
  content       String
  createdAt     DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign    Project?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([campaignId, createdAt])
  @@index([deliverableId, createdAt])
}

model ClientActivity {
  id        String   @id @default(cuid())
  companyId String
  clientId  String
  actorId   String?
  type      String
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ClientActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model Invoice {
  id            String    @id @default(cuid())
  companyId     String
  createdById   String
  clientId      String?
  campaignId    String?
  briefId       String?
  invoiceNumber String
  clientName    String
  clientEmail   String?
  clientAddress String?
  status        String    @default("draft") // draft, sent, paid, overdue
  currency      String    @default("USD")
  locale        String    @default("en") // en, ar
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  notes         String?
  taxRate       Decimal   @default(0) @db.Decimal(5, 2)
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign  Project?      @relation("InvoiceCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  brief     Task?         @relation("InvoiceBrief", fields: [briefId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status, dueDate])
  @@index([companyId, clientId, createdAt])
  @@index([companyId, campaignId, createdAt])
  @@index([companyId, briefId, createdAt])
  @@index([companyId, createdAt])
  @@index([createdById, createdAt])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  deliverableId String?
  description   String
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([deliverableId])
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique
  primaryColor    String   @default("#0369a1")
  backgroundColor String   @default("#f7f8fa")
  sidebarColor    String   @default("#ffffff")
  themeMode       String   @default("light") // light, dark
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model UserDashboardDesign {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String?
  sourceType  String   @default("json") // json, css
  designJson  Json?
  customCss   String?
  compiledCss String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminActionLog {
  id           String   @id @default(cuid())
  companyId    String
  actorId      String
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor      User    @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId, createdAt])
}

model ProjectCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([companyId, name])
  @@index([companyId, createdAt])
}

model Invite {
  id           String    @id @default(cuid())
  companyId    String
  code         String    @unique
  invitedEmail String
  role         String
  createdById  String
  usedById     String?
  used         Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy        User?          @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  accessRequest AccessRequest?

  @@index([companyId, invitedEmail])
  @@index([companyId, used, expiresAt])
}

model AccessRequest {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  name         String
  role         String
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt   DateTime?
  reviewedById String?
  inviteId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  invite     Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, email, status])
}

enum CameraType {
  device
  external
}

model Project {
  id          String     @id @default(cuid())
  title       String
  description String?
  companyId   String
  roomId      String?
  categoryId  String?
  clientId    String?
  clientName  String?
  managerId   String?
  hasCamera   Boolean    @default(false)
  cameraType  CameraType @default(device)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company              Company               @relation(fields: [companyId], references: [id])
  room                 Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category             ProjectCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager              User?                 @relation("ProjectManager", fields: [managerId], references: [id])
  tasks                Task[]
  invoices             Invoice[]             @relation("InvoiceCampaign")
  briefs               Brief[]
  deliverables         Deliverable[]
  cameraMedia          ProjectCameraMedia[]
  projectMedia         ProjectMedia[]
  cameras              ProjectCamera[]
  calendarEvents       CalendarEvent[]
  clientPortalComments ClientPortalComment[]

  @@index([companyId, roomId])
  @@index([companyId, categoryId])
  @@index([companyId, clientId])
}

model ProjectCamera {
  id                String    @id @default(cuid())
  projectId         String
  name              String
  ipAddress         String
  port              Int       @default(554)
  username          String
  encryptedPassword String
  rtspPath          String    @default("/stream")
  status            String    @default("OFFLINE") // OFFLINE, STARTING, ONLINE, ERROR
  lastStartedAt     DateTime?
  lastSeenAt        DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([projectId, status])
}

model ProjectCameraMedia {
  id        String   @id @default(cuid())
  projectId String
  fileUrl   String
  type      String // image | video
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMedia {
  id                 String   @id @default(cuid())
  projectId          String
  uploadedById       String
  url                String
  playbackUrl        String?
  thumbnailUrl       String?
  cloudinaryPublicId String
  type               String // image | video | audio
  mimeType           String
  originalFilename   String
  size               Int
  duration           Float?
  width              Int?
  height             Int?
  format             String?
  createdAt          DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ProjectMediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([uploadedById, createdAt])
  @@index([projectId, type, createdAt])
}

model Comment {
  id                String    @id @default(cuid())
  fileId            String
  deliverableFileId String?
  userId            String
  content           String
  timestamp         Float
  timestampStart    Float?
  timestampEnd      Float?
  frame             Int?
  x                 Float?
  y                 Float?
  width             Float?
  height            Float?
  parentId          String?
  resolved          Boolean   @default(false)
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverableFile DeliverableFile? @relation(fields: [deliverableFileId], references: [id], onDelete: Cascade)
  parent          Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]        @relation("CommentReplies")

  @@index([fileId, timestamp])
  @@index([deliverableFileId, timestampStart, createdAt])
  @@index([fileId, parentId, createdAt])
  @@index([userId, createdAt])
}

model Brief {
  id          String    @id @default(cuid())
  companyId   String
  campaignId  String
  clientId    String?
  createdById String?
  title       String
  description String?
  objectives  Json?
  status      String    @default("DRAFT") // DRAFT, APPROVED, ARCHIVED
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     Project               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client       Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("BriefCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliverables Deliverable[]
  activities   DeliverableActivity[]

  @@index([companyId, campaignId, status, createdAt])
  @@index([companyId, clientId, createdAt])
}

model Deliverable {
  id                   String    @id @default(cuid())
  companyId            String
  campaignId           String
  briefId              String
  title                String
  description          String?
  type                 String    @default("GENERAL") // VIDEO, AUDIO, DESIGN, COPY, GENERAL
  status               String    @default("INTERNAL_REVIEW") // INTERNAL_REVIEW, CLIENT_REVIEW, APPROVED, DELIVERED
  revisionCount        Int       @default(0)
  approvalState        String    @default("PENDING") // PENDING, CHANGES_REQUESTED, APPROVED
  outputSpecifications Json?
  dueAt                DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign             Project               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brief                Brief                 @relation(fields: [briefId], references: [id], onDelete: Cascade)
  tasks                Task[]
  files                DeliverableFile[]
  revisions            DeliverableRevision[]
  approvals            ApprovalDecision[]
  activities           DeliverableActivity[]
  invoiceItems         InvoiceItem[]
  clientPortalComments ClientPortalComment[]

  @@index([companyId, campaignId, status, createdAt])
  @@index([briefId, status, createdAt])
  @@index([approvalState, updatedAt])
}

model DeliverableFile {
  id                 String   @id @default(cuid())
  deliverableId      String
  uploadedById       String
  url                String
  playbackUrl        String?
  thumbnailUrl       String?
  cloudinaryPublicId String?
  type               String
  mimeType           String
  originalFilename   String
  size               Int
  duration           Float?
  width              Int?
  height             Int?
  format             String?
  versionNumber      Int      @default(1)
  createdAt          DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("DeliverableFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([deliverableId, createdAt])
  @@index([uploadedById, createdAt])
  @@index([deliverableId, versionNumber])
}

model DeliverableRevision {
  id            String   @id @default(cuid())
  deliverableId String
  versionNumber Int
  status        String   @default("INTERNAL_REVIEW")
  changeNote    String?
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId, createdAt])
}

model ApprovalDecision {
  id            String   @id @default(cuid())
  companyId     String
  deliverableId String
  clientId      String?
  decidedById   String?
  status        String
  note          String?
  createdAt     DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  decidedBy   User?       @relation("ApprovalDecisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([deliverableId, createdAt])
  @@index([status, createdAt])
}

model DeliverableActivity {
  id            String   @id @default(cuid())
  companyId     String
  briefId       String?
  deliverableId String?
  actorId       String?
  type          String
  title         String
  body          String?
  metadata      Json?
  createdAt     DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brief       Brief?       @relation(fields: [briefId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  actor       User?        @relation("DeliverableActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([briefId, createdAt])
  @@index([deliverableId, createdAt])
  @@index([type, createdAt])
}

model WorkflowTemplate {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  deliverableType String   @default("GENERAL")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps   WorkflowTemplateStep[]

  @@unique([companyId, name])
  @@index([companyId, deliverableType])
}

model WorkflowTemplateStep {
  id              String  @id @default(cuid())
  templateId      String
  title           String
  description     String?
  sortOrder       Int
  defaultPriority String  @default("MEDIUM")

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  deliverableType String    @default("GENERAL")
  deliverableId   String
  deadline        DateTime?
  assigneeId      String?
  projectId       String
  stage           String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  progress        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  project        Project          @relation(fields: [projectId], references: [id])
  deliverable    Deliverable      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  activities     Activity[]
  submissions    TaskSubmission[]
  calendarEvents CalendarEvent[]
  invoices       Invoice[]        @relation("InvoiceBrief")
  subtasks       Subtask[]
  dependencies   TaskDependency[] @relation("TaskDependencyTask")
  dependents     TaskDependency[] @relation("TaskDependencyDependsOn")

  @@index([deliverableId, stage, createdAt])
  @@index([projectId, stage, createdAt])
}

model Subtask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  description String?
  status      String   @default("TODO")
  assigneeId  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId, sortOrder])
  @@index([assigneeId, status])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependencyDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model TaskSubmission {
  id                 String   @id @default(cuid())
  taskId             String
  userId             String
  fileUrl            String
  fileName           String
  fileType           String
  mediaType          String?
  fileSize           Int?
  duration           Float?
  thumbnailUrl       String?
  playbackUrl        String?
  cloudinaryPublicId String?
  note               String?
  createdAt          DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model Activity {
  id         String   @id @default(cuid())
  companyId  String?
  entityType String   @default("task")
  entityId   String?
  taskId     String?
  userId     String?
  action     String
  metadata   Json?
  source     String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Alert {
  id            String    @id @default(cuid())
  companyId     String?
  type          String // URGENT_TASK, DEADLINE_WARNING, MANAGER_CALL
  title         String
  message       String
  senderId      String
  recipientId   String
  read          Boolean   @default(false)
  readAt        DateTime?
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  channel       String    @default("in_app") // in_app, email, push, slack
  deliveryState String    @default("READY") // READY, QUEUED, SENT, FAILED, SUPPRESSED
  entityType    String?
  entityId      String?
  metadata      Json?
  scheduledFor  DateTime?
  createdAt     DateTime  @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender    User     @relation("AlertSender", fields: [senderId], references: [id])
  recipient User     @relation("AlertRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, read, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([priority, deliveryState, scheduledFor])
}

model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  digestMode    String   @default("realtime") // realtime, daily, weekly
  quietHours    Json?
  channels      Json?
  mutedEntities Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model JobRun {
  id          String    @id @default(cuid())
  companyId   String?
  queue       String
  name        String
  status      String    @default("QUEUED") // QUEUED, DEFERRED, ACTIVE, COMPLETED, FAILED, DEAD_LETTER
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  externalId  String?
  entityType  String?
  entityId    String?
  payload     Json?
  result      Json?
  error       String?
  runAt       DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([queue, status, runAt])
  @@index([companyId, status, createdAt])
  @@index([entityType, entityId])
  @@index([externalId])
}

model SearchIndex {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String
  title      String
  subtitle   String?
  content    String?
  href       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityType, entityId])
  @@index([companyId, entityType])
  @@index([companyId, updatedAt])
  @@index([companyId, title])
}

model AnalyticsMetric {
  id          String    @id @default(cuid())
  companyId   String
  key         String
  scope       String    @default("workspace")
  periodStart DateTime?
  periodEnd   DateTime?
  value       Json
  computedAt  DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, scope, periodStart, periodEnd])
  @@index([companyId, key, computedAt])
  @@index([expiresAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("PROJECT_EVENT") // PROJECT_EVENT, MEETING, MILESTONE, BLOCKER
  startsAt    DateTime
  endsAt      DateTime?
  color       String?
  companyId   String
  projectId   String?
  taskId      String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User     @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, startsAt])
  @@index([projectId, startsAt])
  @@index([taskId])
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiConversation {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  title     String?
  context   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([companyId, userId, updatedAt])
  @@index([companyId, createdAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  intent         String?
  citations      Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role, createdAt])
}

model AiMemory {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  scope      String   @default("workspace") // workspace, user
  kind       String
  key        String
  value      String
  confidence Float    @default(0.7)
  source     String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, scope, kind, lastSeenAt])
  @@index([companyId, userId, lastSeenAt])
  @@index([companyId, kind, key])
}

model SocialPlatform {
  id             String   @id @default(cuid())
  slug           String   @unique
  displayName    String
  category       String
  authType       String   @default("oauth2")
  capabilities   Json
  requiredScopes String[]
  optionalScopes String[] @default([])
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connectedAccounts ConnectedAccount[]

  @@index([status, slug])
  @@map("social_platforms")
}

model CreatorProfile {
  id           String   @id @default(cuid())
  companyId    String
  ownerUserId  String?
  displayName  String
  legalName    String?
  primaryEmail String?
  avatarUrl    String?
  status       String   @default("ACTIVE")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner             User?              @relation("CreatorProfileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  connectedAccounts ConnectedAccount[]
  aiInsights        SocialAiInsight[]

  @@index([companyId, status, createdAt])
  @@index([companyId, displayName])
  @@index([ownerUserId, status])
  @@map("creator_profiles")
}

model ConnectedAccount {
  id                String    @id @default(cuid())
  companyId         String
  platformId        String
  platformSlug      String
  creatorProfileId  String?
  connectedById     String?
  providerAccountId String
  handle            String?
  displayName       String
  avatarUrl         String?
  accountType       String    @default("PROFILE")
  status            String    @default("CONNECTED")
  healthStatus      String    @default("HEALTHY")
  scopes            String[]
  metadata          Json?
  syncCursor        String?
  lastSyncAt        DateTime?
  externalCreatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform             SocialPlatform           @relation(fields: [platformId], references: [id], onDelete: Restrict)
  creatorProfile       CreatorProfile?          @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  connectedBy          User?                    @relation("ConnectedAccountConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  token                ProviderToken?
  analyticsSnapshots   AnalyticsSnapshot[]
  realtimeMetrics      RealtimeMetric[]
  audienceDemographics AudienceDemographic[]
  engagementMetrics    EngagementMetric[]
  revenueMetrics       RevenueMetric[]
  contentPerformance   ContentPerformance[]
  aiInsights           SocialAiInsight[]
  syncJobs             SocialSyncJob[]
  webhookEvents        SocialWebhookEvent[]
  activityLogs         IntegrationActivityLog[]

  @@unique([companyId, platformId, providerAccountId])
  @@index([companyId, status, updatedAt])
  @@index([companyId, platformSlug, status])
  @@index([creatorProfileId, status])
  @@index([lastSyncAt])
  @@map("connected_accounts")
}

model ProviderToken {
  id                     String    @id @default(cuid())
  connectedAccountId     String    @unique
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenType              String    @default("Bearer")
  scope                  String?
  expiresAt              DateTime?
  rotationVersion        Int       @default(1)
  lastRefreshedAt        DateTime?
  refreshFailureCount    Int       @default(0)
  revokedAt              DateTime?
  keyId                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@map("provider_tokens")
}

model AnalyticsSnapshot {
  id                 String   @id @default(cuid())
  companyId          String
  connectedAccountId String
  platformSlug       String
  metricDate         DateTime
  granularity        String   @default("day")
  syncJobId          String?
  metrics            Json
  dimensions         Json?
  fingerprint        String
  createdAt          DateTime @default(now())

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, metricDate, granularity, fingerprint])
  @@index([companyId, platformSlug, metricDate])
  @@index([connectedAccountId, metricDate])
  @@index([syncJobId])
  @@map("analytics_snapshots")
}

model RealtimeMetric {
  id                 String   @id @default(cuid())
  companyId          String
  connectedAccountId String
  platformSlug       String
  metricKey          String
  value              Decimal  @db.Decimal(20, 6)
  unit               String   @default("count")
  observedAt         DateTime
  metadata           Json?
  createdAt          DateTime @default(now())

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([companyId, platformSlug, observedAt])
  @@index([connectedAccountId, metricKey, observedAt])
  @@map("realtime_metrics")
}

model AudienceDemographic {
  id                 String   @id @default(cuid())
  companyId          String
  connectedAccountId String
  platformSlug       String
  metricDate         DateTime
  dimension          String
  segment            String
  value              Decimal  @db.Decimal(20, 6)
  percentage         Decimal? @db.Decimal(8, 4)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, metricDate, dimension, segment])
  @@index([companyId, platformSlug, metricDate])
  @@index([dimension, segment])
  @@map("audience_demographics")
}

model EngagementMetric {
  id                   String   @id @default(cuid())
  companyId            String
  connectedAccountId   String
  contentPerformanceId String?
  platformSlug         String
  metricDate           DateTime
  granularity          String   @default("day")
  scope                String   @default("account")
  views                BigInt   @default(0)
  impressions          BigInt   @default(0)
  likes                BigInt   @default(0)
  comments             BigInt   @default(0)
  shares               BigInt   @default(0)
  saves                BigInt   @default(0)
  clicks               BigInt   @default(0)
  watchTimeSeconds     BigInt   @default(0)
  averageViewDuration  Decimal? @db.Decimal(20, 6)
  engagementRate       Decimal? @db.Decimal(8, 4)
  retentionRate        Decimal? @db.Decimal(8, 4)
  ctr                  Decimal? @db.Decimal(8, 4)
  fingerprint          String
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  contentPerformance ContentPerformance? @relation(fields: [contentPerformanceId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, metricDate, granularity, scope, fingerprint])
  @@index([companyId, platformSlug, metricDate])
  @@index([connectedAccountId, metricDate])
  @@index([contentPerformanceId, metricDate])
  @@map("engagement_metrics")
}

model RevenueMetric {
  id                  String   @id @default(cuid())
  companyId           String
  connectedAccountId  String
  contentPerformanceId String?
  platformSlug        String
  metricDate          DateTime
  granularity         String   @default("day")
  currency            String   @default("USD")
  grossRevenue        Decimal  @default(0) @db.Decimal(20, 6)
  estimatedRevenue    Decimal  @default(0) @db.Decimal(20, 6)
  adRevenue           Decimal  @default(0) @db.Decimal(20, 6)
  subscriptionRevenue Decimal  @default(0) @db.Decimal(20, 6)
  affiliateRevenue    Decimal  @default(0) @db.Decimal(20, 6)
  rpm                 Decimal? @db.Decimal(20, 6)
  cpm                 Decimal? @db.Decimal(20, 6)
  fingerprint         String
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  contentPerformance ContentPerformance? @relation(fields: [contentPerformanceId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, metricDate, granularity, currency, fingerprint])
  @@index([companyId, platformSlug, metricDate])
  @@index([connectedAccountId, metricDate])
  @@index([contentPerformanceId, metricDate])
  @@map("revenue_metrics")
}

model ContentPerformance {
  id                 String    @id @default(cuid())
  companyId          String
  connectedAccountId String
  platformSlug       String
  providerContentId  String
  contentType        String
  title              String
  description        String?
  url                String?
  thumbnailUrl       String?
  publishedAt        DateTime?
  durationSeconds    Int?
  metrics            Json?
  revenue            Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount  ConnectedAccount   @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  engagementMetrics EngagementMetric[]
  revenueMetrics    RevenueMetric[]

  @@unique([connectedAccountId, providerContentId])
  @@index([companyId, platformSlug, publishedAt])
  @@index([connectedAccountId, lastSyncedAt])
  @@map("content_performance")
}

model SocialAiInsight {
  id                 String    @id @default(cuid())
  companyId          String
  creatorProfileId   String?
