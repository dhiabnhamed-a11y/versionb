  @@unique([providerSlug, providerEventId])
  @@index([providerSlug, processingStatus, receivedAt])
  @@index([companyId, receivedAt])
  @@index([connectedAccountId, receivedAt])
  @@map("webhook_events")
}

model IntegrationActivityLog {
  id                 String   @id @default(cuid())
  companyId          String
  connectedAccountId String?
  actorId            String?
  action             String
  severity           String   @default("INFO")
  ipAddress          String?
  userAgent          String?
  metadata           Json?
  createdAt          DateTime @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  actor            User?             @relation("IntegrationActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([connectedAccountId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("integration_activity_logs")
}
