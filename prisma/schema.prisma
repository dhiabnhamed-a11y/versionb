  journalEntries  JournalEntry[]
  ledgers         Ledger[]
  reconciliations Reconciliation[]
  budgets         Budget[]
  forecasts       Forecast[]

  @@unique([companyId, name])
  @@index([companyId, status, startsAt, endsAt])
  @@index([closedById, closedAt])
}

model JournalEntry {
  id                String                 @id @default(cuid())
  companyId         String
  periodId          String?
  createdById       String?
  approvedById      String?
  postedById        String?
  invoiceId         String?
  entryNumber       String
  status            JournalEntryStatus     @default(DRAFT)
  sourceType        JournalEntrySourceType @default(MANUAL)
  sourceId          String?
  memo              String?
  currency          String                 @default("USD")
  accountingBasis   String                 @default("ACCRUAL")
  baseCurrency      String                 @default("USD")
  transactionDate   DateTime
  totalDebit        Decimal                @default(0) @db.Decimal(18, 6)
  totalCredit       Decimal                @default(0) @db.Decimal(18, 6)
  totalDebitMinor   BigInt                 @default(0)
  totalCreditMinor  BigInt                 @default(0)
  idempotencyKey    String?
  postedAt          DateTime?
  approvedAt        DateTime?
  reversedAt        DateTime?
  reversalOfEntryId String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period                FinancialPeriod?       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy            User?                  @relation("JournalEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  postedBy              User?                  @relation("JournalEntryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  invoice               Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  reversalOf            JournalEntry?          @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals             JournalEntry[]         @relation("JournalEntryReversal")
  lines                 JournalLine[]
  ledgers               Ledger[]
  transactionReferences TransactionReference[]
  expense               Expense?
  payroll               Payroll?
  treasuryTransaction   TreasuryTransaction?

  @@unique([companyId, entryNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, transactionDate])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, invoiceId, transactionDate])
  @@index([periodId, status])
  @@index([createdById, createdAt])
}

model JournalLine {
  id               String    @id @default(cuid())
  companyId        String
  journalEntryId   String
