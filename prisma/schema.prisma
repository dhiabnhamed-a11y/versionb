generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("EMPLOYEE") // SUPER_ADMIN, OWNER, MANAGER, EMPLOYEE
  accountStatus String   @default("ACTIVE") // PENDING, ACTIVE, REJECTED, DISABLED
  avatar        String?
  authUserId    String?  @unique @db.Uuid
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company                Company?        @relation("CompanyMembers", fields: [companyId], references: [id])
  ownedCompany           Company?        @relation("CompanyOwner")
  managedProjects        Project[]       @relation("ProjectManager")
  assignedTasks          Task[]          @relation("TaskAssignee")
  activities             Activity[]
  sentAlerts             Alert[]         @relation("AlertSender")
  receivedAlerts         Alert[]         @relation("AlertRecipient")
  pushTokens             PushToken[]
  createdInvites         Invite[]        @relation("InviteCreatedBy")
  redeemedInvites        Invite[]        @relation("InviteUsedBy")
  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewedBy")
  reviewedCompanies      Company[]       @relation("CompanyReviewedBy")
  taskSubmissions        TaskSubmission[]
  projectMediaUploads    ProjectMedia[]  @relation("ProjectMediaUploadedBy")
  calendarEvents         CalendarEvent[] @relation("CalendarEventCreatedBy")
}

model Company {
  id                 String    @id @default(cuid())
  name               String
  emailDomain        String?   @unique
  companyType        String    @default("OTHER")
  country            String?
  industry           String?
  registrationNumber String?   @unique
  status             String    @default("PENDING") // PENDING, ACTIVE, REJECTED, DISABLED
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  ownerId            String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner          User            @relation("CompanyOwner", fields: [ownerId], references: [id])
  reviewedBy     User?           @relation("CompanyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  members        User[]          @relation("CompanyMembers")
  rooms          Room[]
  projectCategories ProjectCategory[]
  projects       Project[]
  invites        Invite[]
  accessRequests AccessRequest[]
  calendarEvents CalendarEvent[]

  @@index([status, createdAt])
  @@index([name, registrationNumber, status])
}

model Room {
  id          String    @id @default(cuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId, createdAt])
}

model ProjectCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId, createdAt])
  @@unique([companyId, name])
}

model Invite {
  id           String    @id @default(cuid())
  companyId    String
  code         String    @unique
  invitedEmail String
  role         String
  createdById  String
  usedById     String?
  used         Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy        User?          @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  accessRequest AccessRequest?

  @@index([companyId, invitedEmail])
  @@index([companyId, used, expiresAt])
}

model AccessRequest {
  id           String   @id @default(cuid())
  companyId    String
  email        String
  name         String
  role         String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt   DateTime?
  reviewedById String?
  inviteId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  invite     Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, email, status])
}

enum CameraType {
  device
  external
}

model Project {
  id          String     @id @default(cuid())
  title       String
  description String?
  companyId   String
  roomId      String?
  categoryId  String?
  clientName  String?
  managerId   String?
  hasCamera   Boolean    @default(false)
  cameraType  CameraType @default(device)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  room        Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category    ProjectCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manager     User?                 @relation("ProjectManager", fields: [managerId], references: [id])
  tasks       Task[]
  cameraMedia ProjectCameraMedia[]
  projectMedia ProjectMedia[]
  cameras     ProjectCamera[]
  calendarEvents CalendarEvent[]

  @@index([companyId, roomId])
  @@index([companyId, categoryId])
}

model ProjectCamera {
  id                String    @id @default(cuid())
  projectId         String
  name              String
  ipAddress         String
  port              Int       @default(554)
  username          String
  encryptedPassword String
  rtspPath          String    @default("/stream")
  status            String    @default("OFFLINE") // OFFLINE, STARTING, ONLINE, ERROR
  lastStartedAt     DateTime?
  lastSeenAt        DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([projectId, status])
}

model ProjectCameraMedia {
  id        String   @id @default(cuid())
  projectId String
  fileUrl   String
  type      String // image | video
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMedia {
  id                 String   @id @default(cuid())
  projectId          String
  uploadedById       String
  url                String
  playbackUrl        String?
  thumbnailUrl       String?
  cloudinaryPublicId String
  type               String // image | video | audio
  mimeType           String
  originalFilename   String
  size               Int
  duration           Float?
  width              Int?
  height             Int?
  format             String?
  createdAt          DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ProjectMediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([uploadedById, createdAt])
  @@index([projectId, type, createdAt])
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  deliverableType String   @default("GENERAL")
  deadline        DateTime?
  assigneeId      String?
  projectId       String
  stage           String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  progress        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  project     Project          @relation(fields: [projectId], references: [id])
  activities  Activity[]
  submissions TaskSubmission[]
  calendarEvents CalendarEvent[]
}

model TaskSubmission {
  id        String   @id @default(cuid())
  taskId     String
  userId     String
  fileUrl    String
  fileName   String
  fileType   String
  mediaType  String?
  fileSize   Int?
  duration   Float?
  thumbnailUrl String?
  playbackUrl  String?
  cloudinaryPublicId String?
  note       String?
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Alert {
  id          String   @id @default(cuid())
  type        String   // URGENT_TASK, DEADLINE_WARNING, MANAGER_CALL
  title       String
  message     String
  senderId    String
  recipientId String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("AlertSender", fields: [senderId], references: [id])
  recipient User @relation("AlertRecipient", fields: [recipientId], references: [id])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("PROJECT_EVENT") // PROJECT_EVENT, MEETING, MILESTONE, BLOCKER
  startsAt    DateTime
  endsAt      DateTime?
  color       String?
  companyId   String
  projectId   String?
  taskId      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User     @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, startsAt])
  @@index([projectId, startsAt])
  @@index([taskId])
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
