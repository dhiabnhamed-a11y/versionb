  name             String
  status           String    @default("PLANNED") // PLANNED, SKIPPED, PENDING_APPROVAL, EXECUTING, COMPLETED, FAILED, COMPENSATED
  phase            String    @default("PLAN") // PLAN, PREVIEW, APPROVAL, EXECUTE, COMPENSATE
  toolName         String?
  actionKind       String?
  riskLevel        String    @default("LOW")
  permissionState  String    @default("PENDING") // PENDING, ALLOWED, DENIED, NEEDS_APPROVAL
  input            Json?
  output           Json?
  error            String?
  executionGraph   Json?
  rollback         Json?
  audit            Json?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  estimatedCostUsd Decimal?  @db.Decimal(12, 6)
  retryCount       Int       @default(0)
  maxRetries       Int       @default(3)
  approvalRequired Boolean   @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  aiRun          AiRun             @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  toolExecutions AiToolExecution[]
  approvals      AiApproval[]
  observations   AiObservation[]
  decisions      AiDecision[]

  @@unique([aiRunId, sequence])
  @@index([companyId, status, createdAt])
  @@index([companyId, toolName, createdAt])
  @@index([companyId, riskLevel, status, createdAt])
}

