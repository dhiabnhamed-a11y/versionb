model AiRun {
  id               String    @id @default(cuid())
  companyId        String
  userId           String?
  conversationId   String?
  trigger          String    @default("chat")
  status           String    @default("PLANNED") // PLANNED, PREVIEWED, PENDING_CONFIRMATION, EXECUTING, COMPLETED, FAILED, CANCELLED, EXPIRED
  phase            String    @default("PLAN") // PLAN, PREVIEW, CONFIRM, EXECUTE
  input            Json?
  plan             Json?
  result           Json?
  error            String?
  model            String?
  promptVersion    String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  estimatedCostUsd Decimal?  @db.Decimal(12, 6)
  idempotencyKey   String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?             @relation("AiRunActor", fields: [userId], references: [id], onDelete: SetNull)
