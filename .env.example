# Copy to .env and fill in values from Supabase → Project Settings → Database.

# App runtime (local + Vercel): Transaction pooler — must NOT be db.*.supabase.co:5432
# In the Supabase dashboard, use "Transaction pooler" / URI, port 6543.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma migrate / db push only: "Direct connection" or Session pooler (port 5432 on *.pooler.supabase.com)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket for project camera uploads (create in Supabase → Storage; default name below)
# Set bucket to public read OR add policies so URLs from getPublicUrl work for your app.
SUPABASE_PROJECT_CAMERA_BUCKET="project-camera"

# Cloudinary media delivery for digital agency campaign uploads only.
# Required for image/video/audio uploads and adaptive video streaming.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

NEXTAUTH_SECRET="generate-a-long-random-string"
AUTH_SECRET="same-as-or-different-from-NEXTAUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CAMERA_ENCRYPTION_KEY="generate-a-long-random-string-for-camera-passwords"
FFMPEG_PATH="ffmpeg"
INVITE_TTL_HOURS="48"
BLOCKED_OWNER_EMAIL_DOMAINS="gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,me.com,msn.com,aol.com,proton.me,protonmail.com"
OWNER_ALLOWED_EMAIL_DOMAINS=""

# Firebase Web SDK for browser push notifications only (database stays on Supabase/Prisma)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-web-push-certificate-key-pair"

# Socket.IO only works when the custom server.ts process is hosting the app.
# Leave false/empty on Vercel; set true for local/custom Node deployments that run npm run start.
NEXT_PUBLIC_SOCKET_IO_ENABLED="false"

# Social integrations engine
# Generate SOCIAL_TOKEN_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REDIS_URL="redis://localhost:6379"
QUEUE_REDIS_URL="redis://localhost:6379"
INTEGRATIONS_REDIS_URL="redis://localhost:6379"
SOCIAL_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
SOCIAL_TOKEN_ENCRYPTION_KEY_ID="primary"
SOCIAL_WEBHOOK_SECRET="shared-webhook-hmac-secret"
SOCIAL_WEBHOOK_VERIFY_TOKEN="shared-webhook-verify-token"

YOUTUBE_CLIENT_ID="your-youtube-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-oauth-client-secret"
SPOTIFY_CLIENT_ID="your-spotify-oauth-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-oauth-client-secret"
SPOTIFY_ANALYTICS_API_BASE_URL=""
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
INSTAGRAM_CLIENT_ID="your-meta-instagram-client-id"
INSTAGRAM_CLIENT_SECRET="your-meta-instagram-client-secret"
FACEBOOK_CLIENT_ID="your-meta-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-meta-facebook-client-secret"
TWITTER_CLIENT_ID="your-x-oauth-client-id"
TWITTER_CLIENT_SECRET="your-x-oauth-client-secret"
TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Firebase Admin SDK for server-side push sending only
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
