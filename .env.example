# Copy to .env and fill in values from Supabase → Project Settings → Database.
#
# Vercel production (required): DATABASE_URL (pooler :6543), DIRECT_URL, AUTH_SECRET,
# NEXT_PUBLIC_APP_URL, SUPER_ADMIN_EMAILS, LEGAL_CONSENT_SIGNING_SECRET
# Recommended: REDIS_URL, REALTIME_HEALTH_TOKEN, Supabase keys
# Run before deploy: npm run verify:env  |  Before push: npm run prepush

# ===========================
# STRIPE BILLING
# ===========================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...

# ===========================
# AUTH / SECURITY
# ===========================

# Leave false unless you intentionally enable Google Analytics in the browser.
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# App runtime (local + Vercel): Transaction pooler — must NOT be db.*.supabase.co:5432
# In the Supabase dashboard, use "Transaction pooler" / URI, port 6543.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma migrate / db push only: "Direct connection" or Session pooler (port 5432 on *.pooler.supabase.com)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket for project camera uploads (create in Supabase → Storage; default name below)
# Set bucket to public read OR add policies so URLs from getPublicUrl work for your app.
SUPABASE_PROJECT_CAMERA_BUCKET="project-camera"

# Cloudinary media delivery for digital agency campaign uploads only.
# Required for image/video/audio uploads and adaptive video streaming.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

NEXTAUTH_SECRET="generate-a-long-random-string"
AUTH_SECRET="same-as-or-different-from-NEXTAUTH_SECRET"
# Auth.js/NextAuth canonical URL for the current environment.
# Local: http://localhost:3000
# Production: https://your-production-domain.com
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Comma-separated emails allowed to act as SUPER_ADMIN in production (required in prod).
SUPER_ADMIN_EMAILS="you@company.com"
# Required in production for legal consent integrity.
LEGAL_CONSENT_SIGNING_SECRET="generate-a-long-random-string"
# Disable credential oracle endpoint in production (default).
ALLOW_LOGIN_CHECK="false"
CAMERA_ENCRYPTION_KEY="generate-a-long-random-string-for-camera-passwords"
FFMPEG_PATH="ffmpeg"
INVITE_TTL_HOURS="48"
BLOCKED_OWNER_EMAIL_DOMAINS="gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,me.com,msn.com,aol.com,proton.me,protonmail.com"
OWNER_ALLOWED_EMAIL_DOMAINS=""

# Firebase Web SDK for browser push notifications only (database stays on Supabase/Prisma)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-web-push-certificate-key-pair"

# Socket.IO only works when the custom server.ts process is hosting the app.
# Leave false/empty on Vercel; set true for local/custom Node deployments that run npm run start.
NEXT_PUBLIC_SOCKET_IO_ENABLED="false"
# Optional separate Socket.IO origin for production deployments that run the custom server.
NEXT_PUBLIC_SOCKET_IO_URL=""
NEXT_PUBLIC_SOCKET_IO_PATH="/api/socketio"
REALTIME_GATEWAY_HOST="0.0.0.0"
REALTIME_GATEWAY_PORT="3001"
SOCKET_IO_PATH="/api/socketio"
SOCKET_IO_REDIS_KEY="taskit:socket.io"
SOCKET_IO_RECOVERY_MS="120000"
REALTIME_REDIS_URL="redis://localhost:6379"
REALTIME_PRESENCE_TTL_SECONDS="45"
REALTIME_HEARTBEAT_TTL_SECONDS="35"
REALTIME_HEARTBEAT_REFRESH_MS="30000"
COMMAND_CENTER_CACHE_TTL_SEC="45"
ANALYTICS_CACHE_TTL_SEC="60"
DEPLOY_PLATFORM="cloudflare-opennext"
REALTIME_STREAM_MAXLEN="10000"
REALTIME_DB_REPLAY_LIMIT="500"
REALTIME_CONSUMER_OFFSET_TTL_SECONDS="2592000"
REALTIME_DELIVERY_ATTEMPTS="5"
REALTIME_WORKER_CONCURRENCY="25"
# Set in production to protect /api/realtime/health.
REALTIME_HEALTH_TOKEN=""

# Social integrations engine
# Generate SOCIAL_TOKEN_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REDIS_URL="redis://localhost:6379"
QUEUE_REDIS_URL="redis://localhost:6379"
INTEGRATIONS_REDIS_URL="redis://localhost:6379"
SOCIAL_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
SOCIAL_TOKEN_ENCRYPTION_KEY_ID="primary"
SOCIAL_WEBHOOK_SECRET="shared-webhook-hmac-secret"
SOCIAL_WEBHOOK_VERIFY_TOKEN="shared-webhook-verify-token"
BREACHED_PASSWORD_SHA1_HASHES=""
# HMAC secret for first-party signed API requests that use X-Taskit-Signature.
TASKIT_API_SIGNATURE_SECRET=""
OAUTH_DEBUG="false"
# Optional fixed OAuth callback origin for social provider callbacks.
# Leave empty for localhost/request-origin behavior; set to your production origin only when
# that exact origin is registered in provider consoles and callbacks should be canonical.
SOCIAL_OAUTH_BASE_URL=""
OAUTH_BASE_URL=""
# Comma-separated exact origins that may generate provider redirect_uri values.
# Every origin listed here must have its provider callback URLs registered in Google Cloud.
OAUTH_ALLOWED_ORIGINS="http://localhost:3000,https://your-production-domain.com"

YOUTUBE_CLIENT_ID="your-youtube-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-oauth-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
SPOTIFY_CLIENT_ID="your-spotify-oauth-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-oauth-client-secret"
SPOTIFY_ANALYTICS_API_BASE_URL=""
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
INSTAGRAM_CLIENT_ID="your-meta-instagram-client-id"
INSTAGRAM_CLIENT_SECRET="your-meta-instagram-client-secret"
FACEBOOK_CLIENT_ID="your-meta-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-meta-facebook-client-secret"
TWITTER_CLIENT_ID="your-x-oauth-client-id"
TWITTER_CLIENT_SECRET="your-x-oauth-client-secret"
TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Firebase Admin SDK for server-side push sending only
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
