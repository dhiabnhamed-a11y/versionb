{
  "name": "tasked",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "build:cloudflare": "npm run build && tsx scripts/materialize-standalone-symlinks.ts && opennextjs-cloudflare build --skipNextBuild",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy -- --keep-vars",
    "start": "NODE_ENV=production tsx server.ts",
    "gateway:realtime": "tsx server.realtime.ts",
    "worker": "tsx src/workers/index.ts",
    "worker:realtime": "tsx src/workers/realtime.worker.ts",
    "worker:notifications": "tsx src/workers/notifications.worker.ts",
    "worker:ai": "tsx src/workers/ai.worker.ts",
    "worker:media": "tsx src/workers/media.worker.ts",
    "realtime:load-test": "tsx scripts/realtime-load-test.ts",
    "api:audit": "tsx scripts/audit-api-platform.ts",
    "test:api-governance": "tsx scripts/audit-api-platform.ts",
    "test:unit": "tsx --test src/lib/idempotency/idempotency.test.ts src/lib/legal.test.ts src/lib/workspace-routing.test.ts src/modules/security/security-foundations.test.ts src/services/erp/erp-foundation.test.ts",
    "typecheck": "tsc --noEmit",
    "prepush": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:env": "tsx scripts/verify-vercel-env.ts",
    "diag:login": "tsx scripts/check-login-diagnostics.ts",
    "user:reset-password": "tsx scripts/reset-user-password.ts",
    "diag:test-credentials": "tsx scripts/test-credentials.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:ems": "tsx prisma/seed-ems.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@prisma/adapter-libsql": "^7.7.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tiptap/extension-color": "^3.23.5",
    "@tiptap/extension-placeholder": "^3.23.5",
    "@tiptap/extension-text-style": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.7",
    "cloudinary": "^2.10.0",
    "dodopayments": "^2.32.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "json-bigint": "^1.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "m3u8-parser": "^7.2.0",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.1.1",
    "swr": "^2.4.1",
    "video.js": "^8.23.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsx-ast-utils": "^2.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "4.90.1"
  }
}
